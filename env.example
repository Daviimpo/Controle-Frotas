# Usuários com permissão de edição -> "usuario:senha:perfil" separados por vírgula (perfil: admin | operador)
POLIVIAS_USERS=admin:polivias@2026:admin,operador:operador@2026:operador
# Segredo para assinar o cookie de sessão (troque em produção)
SESSION_SECRET=troque-este-segredo-por-um-valor-longo-e-aleatorio
# Leitura de PDF com IA (opcional). Sem a chave, o sistema usa a extração simulada.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Caminho do arquivo de persistência (opcional)
DATA_FILE=./data/state.json

# ---- Supabase (produção) ----
# Com estas variáveis o app grava nas tabelas frotas / quadro_frotas (rode supabase/migrations/0001_controle_frotas.sql antes)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave service_role (Project Settings > API). Só no servidor — NUNCA use prefixo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# true = na primeira execução, com as tabelas vazias, cria as 64 frotas de exemplo
SEED_MOCK_DATA=false
